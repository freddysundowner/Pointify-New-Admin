modules = ["nodejs-20", "bash", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
POS_API_BASE_URL = "https://api.pointifypos.com"

[userenv.development]
SMS_SEND_ENABLED = "true"
EMAIL_SEND_ENABLED = "true"

[userenv.production]

[nix]
channel = "stable-25_05"
